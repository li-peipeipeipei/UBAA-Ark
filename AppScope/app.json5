{
  "app": {
    "bundleName": "com.ubaa.app",
    "vendor": "BUAASubnet",
    // versionCode 只用于「能否覆盖安装」的单调比较，与 versionName 无算术关系。
    // 历史：0.1.0 = 1000000 → 0.9.0 = 1090000（次版本每 +1 记 10000）。
    // ⚠️ 每次发布必须严格大于上一个已发布的 versionCode，否则 AGC 拒收、
    // 手机上也装不上去（会提示版本号更低）。1.0.0 起按 1e6 段继续 +10000 即可。
    "versionCode": 1090000,
    "versionName": "0.9.0",
    // 分层图标：前景图（透明 PNG）+ 背景图（纯色，无透明像素）。
    // 上架自检要求应用图标必须为分层资源，且不得自行裁剪圆角 / 加内边距。
    // 单层 app_icon 仍保留，供应用内 Image 组件展示（分层资源是 JSON，无法直接作位图显示）。
    "icon": "$media:layered_image",
    "label": "$string:app_name",
    "minAPIVersion": 23,
    "targetAPIVersion": 23
  }
}
