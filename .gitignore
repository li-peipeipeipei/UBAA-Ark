# ===== 构建产物与本地环境 =====
/node_modules
/oh_modules
/local.properties
/build-profile.json5
/.idea
**/build
/.hvigor
.cxx
/.clangd
/.clang-format
/.clang-tidy
**/.test
/.appanalyzer

# ===== 签名与密钥材料：绝不入库 =====
*.p12
*.cer
*.p7b
*.pem
*.keystore
*.csr
# 整个 keys/ 都是签名材料（含 DevEco 的 material 凭据缓存），一律不进仓库。
# 仓库是公开的，任何一项泄露都等于把上架签名交出去。
/keys/

# ===== 系统与编辑器噪声 =====
.DS_Store
Thumbs.db
desktop.ini
*.swp

# ===== 调试临时文件：不要在仓库里堆积 =====
# 根目录只放工程文件，调试截图/日志一律不进仓库（文档配图请放 docs/assets/）
/*.jpeg
/*.jpg
/*.png
/*.webp
/*.log
/*.txt

# ===== 本地临时备份与工具脚本 =====
/.backup/
