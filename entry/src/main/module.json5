{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        // 分层图标（AppScope/resources/base/media/layered_image.json）。
        // 入口 UIAbility 的 icon 优先级高于 app.json5，故此处必须同样指向分层资源，
        // 否则桌面图标回落到单层资源，上架自检仍判「图标未分层」。
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        // 启动页图标：带圆角裁切的单层图（半径 185/1024，与原设计一致）。
        // 启动窗口与冷启动转场不做遮罩裁切，用满幅直角图会在动画里露出直角蓝块，
        // 故此处单独使用预裁圆角的 startIcon，与桌面分层图标的视觉圆角对齐。
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        /*
         * 方向策略：
         * - 静态必须是“允许旋转”，否则平板横屏下系统只给一个竖向兼容窗口
         *   （左右露壁纸、宽度恒为竖屏宽度），运行期 setPreferredOrientation 无法纠正；
         * - 手机端的竖屏锁定由 EntryAbility.onWindowStageCreate 运行期下发
         *   （ImmersiveUtil.applyOrientationPolicy）。
         * auto_rotation_restricted = 跟随传感器，仅正向（不含倒置）。
         */
        "orientation": "auto_rotation_restricted",
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    /*
     * 桌面服务卡片提供方（Service Widget）。
     *
     * - type 必须为 "form"；
     * - metadata 的 name 固定为 "ohos.extension.form"，resource 指向卡片配置
     *   （resources/base/profile/form_config.json）—— 键名写错或漏写，上架会被判不合规；
     * - 这里不需要 skills（那是 UIAbility 的入口声明）。
     */
    "extensionAbilities": [
      {
        "name": "UBAAFormAbility",
        "srcEntry": "./ets/entryformability/UBAAFormAbility.ets",
        "label": "$string:UBAAFormAbility_label",
        "description": "$string:UBAAFormAbility_desc",
        "type": "form",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:permission_internet_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility",
            "UBAAFormAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:permission_network_info_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility",
            "UBAAFormAbility"
          ],
          "when": "always"
        }
      }
    ],
    "metadata": [
      {
        /*
         * 应用级沉浸光感开关（系统级 uiMaterial）。
         *
         * name/value 必须用官方枚举值：
         *   name  = ohos.arkui.UIMaterial.state
         *   value = enable | default | disable
         * 之前写的 "uiMaterial"/"true" 不在官方枚举内，等价于未配置（落到 default）。
         *
         * 改成 enable 的影响（全局，非局部）：
         * - Select/Toggle/Menu/Chip/Toast/Dialog/Navigation/Tabs 悬浮底栏等更多组件
         *   默认开启沉浸光感，且材质样式优先级高于组件自身 background/blur/shadow/border；
         * - 自绘按钮用的 uiMaterial.ImmersiveMaterial 与 HDS 的 hdsMaterial 是两套 API，
         *   这里改 enable 不会让自绘返回按钮跟随 HDS 的 MaterialLevel.ADAPTIVE 档位；
         * - API 26 起系统级 uiMaterial 才生效；API 23 上该 metadata 被忽略，
         *   沉浸光感仍由 HDS 组件的 systemMaterialEffect 提供。
         */
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ]
  }
}
